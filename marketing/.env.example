# Claude Class - Environment Variables
# Copia este archivo a .env.local y completa con tus valores

# ============================================
# DOMINIO
# ============================================
NEXT_PUBLIC_DOMAIN=claudeclass.com
NEXT_PUBLIC_SITE_URL=https://claudeclass.com

# ============================================
# STRIPE (Pagos)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# ============================================
# MAILCHIMP (Email Marketing)
# ============================================
MAILCHIMP_API_KEY=xxxxx-us1
MAILCHIMP_LIST_ID=xxxxx
MAILCHIMP_AUDIENCE_ID=xxxxx

# ============================================
# GUMROAD (Alternativa a Stripe)
# ============================================
GUMROAD_AFFILIATE_ID=xxxxx
GUMROAD_PRODUCTS_JSON={
  "starter": "https://gumroad.com/...",
  "professional": "https://gumroad.com/...",
  "vip": "https://gumroad.com/..."
}

# ============================================
# YOUTUBE (Videos)
# ============================================
NEXT_PUBLIC_YOUTUBE_API_KEY=xxxxx
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxx
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID_MOD1=PLxxxxx

# ============================================
# GOOGLE ANALYTICS
# ============================================
NEXT_PUBLIC_GA_ID=G-XXXXX

# ============================================
# FIREBASE (Opcional - para base de datos)
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxx
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxxxx

# ============================================
# DISCORD (Comunidad)
# ============================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx
NEXT_PUBLIC_DISCORD_INVITE_LINK=https://discord.gg/xxxxx

# ============================================
# SENDGRID (Email transaccional)
# ============================================
SENDGRID_API_KEY=SG.xxxxx

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
DEBUG=false
